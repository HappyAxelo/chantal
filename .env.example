# ---------------------------------------------------------------- site
# Public canonical URL (no trailing slash). Used for canonical links, sitemap, emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Show labelled "To confirm" placeholders. Always on in `next dev`.
# Set true on a staging deployment; NEVER on the public production site.
NEXT_PUBLIC_DRAFT_PREVIEW=false

# ------------------------------------------------------------ supabase
# When all three are set, Supabase is used for data and admin sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never expose to the browser or commit to git.
SUPABASE_SERVICE_ROLE_KEY=

# Without Supabase, development uses a local JSON file store in .data/.
# Production refuses it unless explicitly allowed (single-instance hosting only).
ALLOW_LOCAL_STORE=false

# ------------------------------------------------- development admin login
# Used only when Supabase is NOT configured and NODE_ENV != production.
ADMIN_DEV_PASSWORD=
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ADMIN_SESSION_SECRET=

# --------------------------------------------------------------- email
# "live" sends via Resend; anything else only logs (and writes .data/outbox in dev).
EMAIL_MODE=log
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Bookings <bookings@yourdomain.com>"
EMAIL_FROM=
# Where new inquiry / booking notifications go.
ADMIN_NOTIFICATION_EMAIL=
# Optional (staging): reroute ALL outgoing email to this one address.
EMAIL_REDIRECT_TO=
